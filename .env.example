# Backend / frontend wiring
EMAIL_ASSISTANT_API=http://127.0.0.1:8000

# --- Gmail only (each developer uses their own Google Cloud OAuth client + login) ---
# After OAuth via /setup, leave empty so the token’s mailbox is used. If set wrong here, screening can misbehave.
GMAIL_ACCOUNT=
# OAuth client: use .env vars OR save via Next.js Setup page (writes .secrets/oauth_app.json).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Web OAuth redirect — must match Google Cloud Console → Credentials → Web client → Authorized redirect URIs.
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
# Where the API redirects after Google login (Next.js).
FRONTEND_URL=http://127.0.0.1:3000
# Where to store refresh token (default: .secrets/token.json under repo root).
# GMAIL_TOKEN_PATH=.secrets/token.json

# Optional defaults for compose form
EMAIL_DEFAULT_TO=friend@example.com

# Risk agent defaults
RISK_THRESHOLD=0.65
RISK_LLM_MODEL=936565b3-dfac-4ebf-bb8c-d4ec98ad8039
RISK_LLM_ENABLED=true
RISK_LLM_API_URL=https://api.pioneer.ai/gliner-2/custom
RISK_LLM_API_KEY=
RISK_LLM_JOB_ID=936565b3-dfac-4ebf-bb8c-d4ec98ad8039
RISK_LLM_TASK=classify_text
RISK_LLM_SCHEMA_CATEGORIES=scam,legitimate
RISK_LLM_THRESHOLD=0.5
RISK_LLM_TIMEOUT_SECONDS=20
# rules_only | hybrid | llm_only
RISK_DECISION_MODE=hybrid
# If true and llm_only mode cannot call the LLM, quarantine by default.
RISK_FAIL_CLOSED=false
RISK_LINK_SCAN_ENABLED=true
RISK_LINK_SCAN_MAX_URLS=3
RISK_LINK_SCAN_TIMEOUT_SECONDS=20
RISK_LINK_SCAN_FAIL_CLOSED=true
RISK_LINK_SCAN_ALLOW_HTTP=false
RISK_SCREENING_ENABLED=true
RISK_SCREENING_INTERVAL_SECONDS=60
RISK_SCREENING_MAX_BATCH_SIZE=25
RISK_SCREENING_LOOKBACK_MINUTES=240
RISK_SCREENING_ACCOUNT=
RISK_PROCESSED_MESSAGES_PATH=data/processed_messages.jsonl
YUTORI_API_KEY=
YUTORI_BASE_URL=https://api.yutori.com/v1
YUTORI_BROWSE_MAX_STEPS=20
YUTORI_BROWSE_PATH=/browsing/tasks
YUTORI_BROWSE_RESULT_PATH=/browsing/tasks/{task_id}
YUTORI_POLL_TIMEOUT_SECONDS=90
RISK_QUARANTINE_PATH=data/quarantine.jsonl
RISK_FEEDBACK_PATH=data/training_feedback.jsonl
RISK_MODEL_VERSION=risk-agent-v1
